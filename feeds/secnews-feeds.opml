<?xml version="1.0" encoding="UTF-8"?>
<!--
  secnews-omv feed list for Miniflux (Settings -> Import).
  Most URLs were checked on 2026-10-17 to return a valid RSS/Atom feed; the rest were
  imported into Miniflux. Feeds that failed after import were fixed (Google Threat
  Intelligence) or removed (Check Point Research: bot protection; OpenMediaVault tags: empty).
  Feeds can break at any time; Miniflux flags them with an error.
-->
<opml version="2.0">
  <head>
    <title>SecNews feeds</title>
    <dateCreated>Sat, 17 Oct 2026 14:30:00 +0300</dateCreated>
  </head>
